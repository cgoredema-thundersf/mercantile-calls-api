		<parquet:write-avro-to-parquet doc:name="Write Avro to Parquet - File" doc:id="82b29797-72ea-4087-affd-66d75aaf31d0" parquetFilePath='#["D:/batch_" ++ vars.correlationId ++ ".parquet"]'/>
